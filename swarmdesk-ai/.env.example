# SwarmDesk AI — Environment Variables
# Copy to .env and fill in your values

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── Azure AI Search ───────────────────────────────────────────────────────────
AZURE_AI_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_AI_SEARCH_KEY=your_search_admin_key_here

# ── Azure Cosmos DB ───────────────────────────────────────────────────────────
AZURE_COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
AZURE_COSMOS_KEY=your_cosmos_key_here
COSMOS_DATABASE_NAME=swarmdesk
COSMOS_CONTAINER_NAME=tickets

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App Config ────────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=75
APP_ENV=development
